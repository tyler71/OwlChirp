# Server
APP_PORT=4444
HOST=0.0.0.0
LOG_LEVEL=info
DEV_MODE=false

# SQLite database path. DB_STRING (Python-era sqlite+aiosqlite:////path) is also accepted.
DB_DSN=./_data/owlchirp.sqlite3

# Amazon Connect
CONNECT_INSTANCE=00000000-0000-0000-0000-000000000000
CONNECT_DOMAIN=https://your-instance.my.connect.aws
AWS_DEFAULT_REGION=us-west-2
# Seconds to cache the realtime metric snapshot
AWS_CONNECT_CACHE_LENGTH=10
# AWS credentials come from the default chain (env, profile, instance role)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Frontend (served at /api/config)
# https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIME_ZONE=America/Los_Angeles
TELEMETRY_URL=

# Web push (VAPID)
# Generate keys with: npx web-push generate-vapid-keys
# VAPID_SUBJECT is a mailto: or https: URL identifying the sender
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
