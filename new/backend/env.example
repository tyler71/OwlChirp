# Server
APP_PORT=4444
HOST=0.0.0.0
LOG_LEVEL=info
DEV_MODE=false

# SQLite database path. DB_STRING (Python-era sqlite+aiosqlite:////path) is also accepted.
DB_DSN=./_data/owlchirp.sqlite3

# Amazon Connect
CONNECT_INSTANCE=00000000-0000-0000-0000-000000000000
CONNECT_DOMAIN=https://your-instance.my.connect.aws
AWS_DEFAULT_REGION=us-west-2
# Seconds to cache the realtime metric snapshot
AWS_CONNECT_CACHE_LENGTH=10
# AWS credentials come from the default chain (env, profile, instance role)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Flow Calls: inbound calls are polled from Connect SearchContacts so agents
# can see calls still in the contact flow. The AWS role needs
# connect:SearchContacts, connect:DescribeContact and connect:DescribeQueue.
# Seconds between polls; 0 disables polling.
FLOW_POLL_INTERVAL=5
# Days of flow call history to keep
FLOW_RETENTION_DAYS=7

# Frontend (served at /api/config)
# https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIME_ZONE=America/Los_Angeles
TELEMETRY_URL=

# GO Feature Flag relay proxy. The integer "owlchirp" flag (targeting key =
# Connect username) sets each agent's permission level: 0 standard, 1 power
# (timeline, flow calls, feed), 2 admin (agent names). Errors count as 0.
# Empty disables flags, which makes everyone standard.
GOFF_ENDPOINT=https://flag.sandcatdev.com
# Sent as X-API-Key when the relay has authorizedKeys configured
GOFF_API_KEY=

# Web push (VAPID)
# Generate keys with: npx web-push generate-vapid-keys
# VAPID_SUBJECT is a mailto: or https: URL identifying the sender
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
